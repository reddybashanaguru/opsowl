# OpsOwl API — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# Server
PORT=8080
ENVIRONMENT=development

# Database (PostgreSQL 18 + pgvector)
DATABASE_URL=postgres://opsowl:opsowldev@localhost:5432/opsowl?sslmode=disable

# JWT — RS256 key paths (generate with: make gen-keys)
JWT_PUBLIC_KEY_PATH=keys/public.pem
JWT_PRIVATE_KEY_PATH=keys/private.pem
JWT_ACCESS_EXPIRY=1h
JWT_REFRESH_EXPIRY=168h

# File Storage (MinIO for dev, S3 for prod)
STORAGE_ENDPOINT=localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin123
STORAGE_BUCKET=opsowl
STORAGE_USE_SSL=false

# Python AI Service
AI_SERVICE_URL=http://localhost:8000

# AI Provider Keys (set at least one)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
