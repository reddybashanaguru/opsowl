ENVIRONMENT=development
DATABASE_URL=postgres://opsowl:opsowldev@localhost:5432/opsowl
GO_API_URL=http://localhost:8080

# ── LLM provider ──────────────────────────────────────────────────────────────
# 'ollama'    — air-gapped on-premise (default, RBI-compliant, no data leaves network)
# 'anthropic' — cloud AI add-on (requires ANTHROPIC_API_KEY + client approval)
# 'openai'    — cloud AI add-on (requires OPENAI_API_KEY + client approval)
DEFAULT_PROVIDER=ollama

# ── Ollama (used when DEFAULT_PROVIDER=ollama) ────────────────────────────────
# In Docker Compose: OLLAMA_BASE_URL=http://ollama:11434
# In local dev (Ollama running natively): OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# ── Cloud AI credentials (leave empty for air-gapped deployments) ─────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ── Cloud AI model (used when DEFAULT_PROVIDER=anthropic) ─────────────────────
DEFAULT_MODEL=claude-sonnet-4-6
EMBEDDING_MODEL=text-embedding-3-small
