# ─────────────────────────────────────────────────────────────────────────────
# OpsOwl AI — On-Premise Deployment Configuration
# Copy this file: cp .env.example .env
# Fill in every CHANGE_ME value before running install.sh
# NEVER commit .env to git
# ─────────────────────────────────────────────────────────────────────────────

# ── OpsOwl Release Version ────────────────────────────────────────────────────
# Pin to a specific release tag (e.g. 1.0.0) for production.
# Use "latest" only for evaluation/POC deployments.
OPSOWL_VERSION=1.0.0

# ── Public URL (how users reach OpsOwl in a browser) ─────────────────────────
# Set to https://your-domain.com or https://your-server-ip
PUBLIC_URL=https://CHANGE_ME_YOUR_DOMAIN_OR_IP
CORS_ALLOWED_ORIGINS=https://CHANGE_ME_YOUR_DOMAIN_OR_IP

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_DB=opsowl
POSTGRES_USER=opsowl
# Generate: openssl rand -base64 24
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD

# ── MinIO (document/evidence object storage) ─────────────────────────────────
# Generate: openssl rand -base64 12  (min 8 chars)
MINIO_ROOT_USER=opsowl-minio
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_PASSWORD
# SSE-S3 encryption key. Generate: openssl rand -base64 32
# Format must be: <key-name>:<base64-32-bytes>
MINIO_KMS_SECRET_KEY=opsowl-key:CHANGE_ME_RUN_openssl_rand_base64_32

# ── Security Keys ─────────────────────────────────────────────────────────────
# AES-256 column encryption key (base64-encoded 32 bytes).
# Generate: openssl rand -base64 32
ENCRYPTION_KEY=CHANGE_ME_RUN_openssl_rand_base64_32

# Shared secret for Go API ↔ Python AI service authentication.
# Generate: openssl rand -hex 32
AI_SERVICE_SECRET=CHANGE_ME_RUN_openssl_rand_hex_32

# Grafana admin password
GRAFANA_PASSWORD=CHANGE_ME_GRAFANA_PASSWORD

# ── First-Boot Admin User ─────────────────────────────────────────────────────
# These env vars seed the initial super_admin on first startup when no users
# exist. After the first boot they are safe to leave set or remove.
SEED_ADMIN_EMAIL=admin@yourdomain.com
SEED_ADMIN_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD
SEED_ADMIN_NAME=System Administrator

# ── AI Provider ───────────────────────────────────────────────────────────────
# DEFAULT: Ollama (all AI inference runs locally — no data leaves your server).
# Set DEFAULT_PROVIDER=anthropic or openai to use cloud AI (requires internet).
DEFAULT_PROVIDER=ollama
OLLAMA_MODEL=llama3.1:8b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Cloud AI credentials (leave blank for air-gapped deployments)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ── LDAP / Active Directory (optional) ───────────────────────────────────────
# Leave blank to use OpsOwl's built-in user management.
# Example: ldap://dc.yourcompany.com:389  or  ldaps://dc.yourcompany.com:636
LDAP_URL=
LDAP_BASE_DN=
LDAP_USER_ATTR=sAMAccountName
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=

# ── Email / SMTP (optional) ───────────────────────────────────────────────────
# Required for password-reset emails and scheduled reports.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@yourdomain.com
SMTP_TLS=true

# ── SIEM Integration (optional) ───────────────────────────────────────────────
# Forward audit events to Splunk, QRadar, Wazuh, or any webhook receiver.
# Leave blank to disable.
SIEM_WEBHOOK_URL=
SIEM_FORMAT=json

# ── Backup to S3-compatible storage (optional) ────────────────────────────────
# Leave BACKUP_S3_BUCKET blank to keep backups only on-disk (7-day retention).
BACKUP_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-south-1

# ── Rate Limiting ─────────────────────────────────────────────────────────────
MAX_REQUESTS_PER_MIN=100

# ── Workspace Labels (customise terminology to match your organisation) ────────
# Admins can further customise these in Settings → Workspace after deployment.
INDUSTRY=financial_services
CASE_LABEL=Case
CASES_LABEL=Cases
TASK_LABEL=Task
TASKS_LABEL=Tasks
DOCUMENT_LABEL=Document
DOCUMENTS_LABEL=Documents
RISK_SCORE_LABEL=Risk Score
RISK_LEVEL_LABEL=Risk Level
SLA_LABEL=SLA
COMMS_LABEL=Communications
ANALYST_LABEL=Analyst
TIMELINE_LABEL=Timeline
NOTE_LABEL=Note
NOTES_LABEL=Notes
