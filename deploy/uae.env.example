# ─────────────────────────────────────────────────────────────────────────────
# OpsOwl AI — UAE Deployment Configuration
# Federal Decree-Law No. 20 of 2018 on AML/CFT
# Central Bank of UAE (CBUAE) Supervisory Guidance
#
# Copy this file to .env and fill in your values.
# ─────────────────────────────────────────────────────────────────────────────

# ── Infrastructure ─────────────────────────────────────────────────────────────
PORT=8080
ENVIRONMENT=production
DATABASE_URL=postgres://opsowl:CHANGE_ME@db:5432/opsowl?sslmode=require

# ── Object Storage (MinIO / S3) ────────────────────────────────────────────────
STORAGE_ENDPOINT=minio:9000
STORAGE_ACCESS_KEY=CHANGE_ME
STORAGE_SECRET_KEY=CHANGE_ME_32_CHARS_MINIMUM
STORAGE_BUCKET=opsowl
STORAGE_USE_SSL=false

# ── JWT ────────────────────────────────────────────────────────────────────────
JWT_ACCESS_EXPIRY=1h
JWT_REFRESH_EXPIRY=168h
JWT_PUBLIC_KEY_PATH=keys/public.pem
JWT_PRIVATE_KEY_PATH=keys/private.pem

# ── Security ───────────────────────────────────────────────────────────────────
# Generate: openssl rand -base64 32
ENCRYPTION_KEY=CHANGE_ME_BASE64_32_BYTES

# ── AI Services (optional) ────────────────────────────────────────────────────
AI_SERVICE_URL=http://ai:8000
AI_SERVICE_SECRET=CHANGE_ME
ANTHROPIC_API_KEY=sk-ant-CHANGE_ME
OPENAI_API_KEY=

# ── SMTP ───────────────────────────────────────────────────────────────────────
SMTP_HOST=smtp.yourprovider.ae
SMTP_PORT=587
SMTP_USER=noreply@yourbank.ae
SMTP_PASSWORD=CHANGE_ME
SMTP_FROM=noreply@yourbank.ae
SMTP_TLS=true

# ── SIEM / SOAR integration (optional) ────────────────────────────────────────
SIEM_WEBHOOK_URL=
SIEM_FORMAT=json

# ── Password Policy ────────────────────────────────────────────────────────────
PASSWORD_EXPIRY_DAYS=90
PASSWORD_HISTORY_COUNT=5
PASSWORD_MIN_LENGTH=12
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_NUMBER=true
MAX_SESSIONS_PER_USER=5
MAX_REQUESTS_PER_MIN=100

# ─────────────────────────────────────────────────────────────────────────────
# UAE JURISDICTION SETTINGS
# These configure OpsOwl for UAE AML/CFT compliance:
#   Federal Decree-Law No. 20 of 2018 (AML/CFT)
#   CBUAE Supervisory Guidance on Financial Crime
#   UAE FIU goAML 4.0 reporting portal
# ─────────────────────────────────────────────────────────────────────────────

# ── Regulatory labels ──────────────────────────────────────────────────────────
STR_LABEL=STR
STR_REFERENCE_LABEL=UAE FIU Reference
STR_REGULATOR_LABEL=UAE FIU
STR_LAW_REFERENCE=Federal Decree-Law No. 20 of 2018
STR_ID_LABEL=Emirates ID

# ── STR filing deadline ────────────────────────────────────────────────────────
# Art. 15: 30 calendar days from the date suspicion first arose.
STR_DEADLINE_DAYS=30

# ── Currency ───────────────────────────────────────────────────────────────────
# UAE Dirham — pegged to USD at 3.6725
LOCAL_CURRENCY=AED
CURRENCY_SYMBOL=AED

# ── Reporting thresholds ──────────────────────────────────────────────────────
# CTR threshold: AED 55,000 (CBUAE cash transaction reporting requirement)
CTR_THRESHOLD=55000
# Wire record-keeping: AED 3,675 (equivalent to USD 1,000 at 3.6725 peg)
WIRE_THRESHOLD=3675

# ── Identity document types accepted in the UAE ────────────────────────────────
ID_TYPES=PASSPORT,EMIRATES_ID,UAE_TRADE_LICENSE,TRN,GCC_NATIONAL_ID,RESIDENCY_VISA,DRIVING_LICENSE,OTHER

# ── Industry preset ────────────────────────────────────────────────────────────
INDUSTRY=financial_services
CASE_LABEL=Case
CASES_LABEL=Cases
TASK_LABEL=Task
TASKS_LABEL=Tasks
DOCUMENT_LABEL=Document
DOCUMENTS_LABEL=Documents
RISK_SCORE_LABEL=Risk Score
RISK_LEVEL_LABEL=Risk Level
SLA_LABEL=SLA
COMMS_LABEL=Communications
ANALYST_LABEL=Analyst
TIMELINE_LABEL=Timeline
NOTE_LABEL=Note
NOTES_LABEL=Notes
