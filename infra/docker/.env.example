# OpsOwl Docker Compose — environment template
# Copy this file to .env and fill in the values before running docker compose.
# NEVER commit .env to git — it contains production secrets.

# ── Database ─────────────────────────────────────────────────────────────────
POSTGRES_USER=opsowl
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=opsowl

# ── Object Storage (MinIO) ────────────────────────────────────────────────────
MINIO_ROOT_USER=change-me-user
MINIO_ROOT_PASSWORD=change-me-password
# AES-256 master key for MinIO server-side encryption.
# Generate: openssl rand -hex 32
MINIO_KMS_SECRET_KEY=

# ── Inter-service Auth ────────────────────────────────────────────────────────
# Shared secret for Go API → Python AI service calls.
# Generate: openssl rand -hex 32
AI_SERVICE_SECRET=change-me-generate-with-openssl-rand-hex-32

# ── AES-256 Encryption (field-level) ─────────────────────────────────────────
# 32-byte base64 key for encrypting sensitive DB fields.
# Generate: openssl rand -base64 32
ENCRYPTION_KEY=

# ── LLM Provider ─────────────────────────────────────────────────────────────
# 'ollama'     — air-gapped on-premise inference (default, recommended)
# 'anthropic'  — cloud AI (requires ANTHROPIC_API_KEY)
DEFAULT_PROVIDER=ollama
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Cloud AI — leave empty for air-gapped deployments
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ── Frontend ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8080

# ── Nginx / CORS ──────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=https://localhost

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@opsowl.local
SMTP_TLS=true

# ── SIEM Webhook ──────────────────────────────────────────────────────────────
SIEM_WEBHOOK_URL=
SIEM_FORMAT=json

# ── Monitoring ────────────────────────────────────────────────────────────────
# Generate: openssl rand -base64 12
GRAFANA_PASSWORD=change-me
ALERT_EMAIL=ops@your-org.local

# ── Backup (S3 offsite — optional) ────────────────────────────────────────────
BACKUP_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-south-1

# ── Security Policy ───────────────────────────────────────────────────────────
ENVIRONMENT=production
PASSWORD_EXPIRY_DAYS=90
PASSWORD_HISTORY_COUNT=5
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_NUMBER=true
MAX_SESSIONS_PER_USER=5
MAX_REQUESTS_PER_MIN=100
