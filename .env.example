# ─────────────────────────────────────────────────────────────────────────────
# OpsOwl — Environment Configuration
# Copy this file to .env and fill in your values before running 'make up'
# NEVER commit .env to git
# ─────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_DB=opsowl
POSTGRES_USER=opsowl
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE

# ── MinIO (object storage) ────────────────────────────────────────────────────
MINIO_ROOT_USER=CHANGE_ME_MINIO_USER
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_PASSWORD_MIN_8_CHARS
# SSE encryption key — REQUIRED, no default. Generate: openssl rand -base64 32
# Format: <key-name>:<base64-encoded-32-byte-key>
MINIO_KMS_SECRET_KEY=opsowl-key:CHANGE_ME_RUN_openssl_rand_base64_32

# ── API ───────────────────────────────────────────────────────────────────────
API_PORT=8080
ENVIRONMENT=production

# ── AI Provider Keys (leave blank if using Ollama local models) ───────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ── LDAP / Active Directory (optional — leave blank to use local auth) ────────
# Example: ldap://dc.yourcompany.com:389  or  ldaps://dc.yourcompany.com:636
LDAP_URL=
# Base DN to search users, e.g. dc=yourcompany,dc=com
LDAP_BASE_DN=
# Attribute that holds the user's login name, e.g. sAMAccountName or uid
LDAP_USER_ATTR=sAMAccountName
# Service account for initial bind (needed to search the directory)
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=

# ── TLS / Nginx ───────────────────────────────────────────────────────────────
# Path to your SSL certificate and private key (PEM format)
# For dev: run  make gen-certs  to generate a self-signed pair
TLS_CERT_PATH=./infra/docker/nginx/ssl/server.crt
TLS_KEY_PATH=./infra/docker/nginx/ssl/server.key
# Comma-separated list of origins allowed for CORS (your web domain)
CORS_ALLOWED_ORIGINS=https://localhost

# ── Frontend ──────────────────────────────────────────────────────────────────
# Public API URL as seen by the browser (points to Nginx)
NEXT_PUBLIC_API_URL=https://localhost

# ── Workspace Labels (deployment defaults) ────────────────────────────────────
# These define the default terminology for your organisation.
# Each on-premise client sets these to match their vocabulary.
# Admins can further customise labels via Settings in the UI (stored in DB).
# "Reset to Deployment Defaults" in Settings restores these values.
#
# Example: SBI (fraud investigation team)
#   CASE_LABEL=Investigation
#   CASES_LABEL=Investigations
#   TASK_LABEL=Action Item
#   TASKS_LABEL=Action Items
#   DOCUMENT_LABEL=Evidence
#   DOCUMENTS_LABEL=Evidence
#   ANALYST_LABEL=Investigation Officer
#   SLA_LABEL=TAT
#   COMMS_LABEL=Correspondence
#   TIMELINE_LABEL=Activity Log
#   NOTE_LABEL=Remark
#   NOTES_LABEL=Remarks
#
# Example: Insurance company
#   CASE_LABEL=Claim
#   CASES_LABEL=Claims
#   ANALYST_LABEL=Adjuster
#   SLA_LABEL=SLA
#
INDUSTRY=financial_services
CASE_LABEL=Case
CASES_LABEL=Cases
TASK_LABEL=Task
TASKS_LABEL=Tasks
DOCUMENT_LABEL=Document
DOCUMENTS_LABEL=Documents
RISK_SCORE_LABEL=Risk Score
RISK_LEVEL_LABEL=Risk Level
SLA_LABEL=SLA
COMMS_LABEL=Communications
ANALYST_LABEL=Analyst
TIMELINE_LABEL=Timeline
NOTE_LABEL=Note
NOTES_LABEL=Notes
